# Optional: enables Gemini-backed chat, grounding, and generated speech.
GEMINI_API_KEY=your_gemini_api_key

# Optional: public deployment URL for app integrations.
APP_URL=http://localhost:3000
HOST=127.0.0.1
RAVANA_ENABLE_APPROVED_EXECUTION=false
# Optional local file-store directory. Defaults to .ravana-data in the project root.
RAVANA_DATA_DIR=.ravana-data
# Comma-separated exact browser origins, if additional local origins are needed.
ALLOWED_ORIGINS=
